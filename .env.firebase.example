# [LEGACY — Firebase / Cloud Run API secrets]
# For Firebase Hosting only use: npm run deploy:hosting
#
# Copy if you still deploy the API with scripts that read this file:
#   cp .env.firebase.example .env.firebase

# Firebase / Google Cloud
FIREBASE_PROJECT_ID=thepinkfront
CLOUD_RUN_REGION=me-west1
CLOUD_RUN_SERVICE=thepinkfront-api

# Site URL after custom domain
SITE_URL=https://your-domain.com

# Backend
MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/dykehaton
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
ADMIN_WHITELIST=admin@example.com
CLIENT_ORIGIN=https://your-domain.com
COOKIE_SECURE=true
