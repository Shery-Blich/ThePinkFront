# Optional backend secrets (local Node API only — not used by Firebase Hosting build)
# Copy: cp .env.firebase.example backend/.env   (or keep secrets in backend/.env)
#
# Game hosting deploy needs no env file — only:
#   npm run deploy

FIREBASE_PROJECT_ID=thepinkfront
SITE_URL=https://thepinkfront.web.app

# Backend (npm run dev:backend)
MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/dykehaton
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
ADMIN_WHITELIST=admin@example.com
CLIENT_ORIGIN=https://thepinkfront.web.app
COOKIE_SECURE=true
