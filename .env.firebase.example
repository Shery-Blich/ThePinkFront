# Optional backend secrets (local Node API — not used by Firebase Hosting static build)
#
# Game: npm run deploy (no env needed for hosting)
# Admin Auth0 + API: frontend/.env (VITE_AUTH0_*) and backend/.env (AUTH0_*, ADMIN_WHITELIST)

