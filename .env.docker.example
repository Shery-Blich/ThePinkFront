# העתיקו לקובץ .env בשורש הפרויקט לפני הרצה:
#   cp .env.docker.example .env
#   npm run docker:up
# ואז פתחו:
#   http://localhost:8080         — המשחק
#   http://localhost:8080/admin   — פאנל אדמין
#   http://localhost:3001/api/health — API ישירות (אופציונלי)

# --- פורטים ב-localhost ---
WEB_PORT=8080
BACKEND_PORT=3001
MONGO_PORT=27017
# אם 3001 תפוס (פרויקט אחר), שנו לדוגמה: BACKEND_PORT=3002

# CORS — חייב להתאים לכתובת שבה פותחים את האתר בדפדפן
# אפשר גם רשימה מופרדת בפסיקים. localhost ו-127.0.0.1 מאופשרים יחד אוטומטית.
CLIENT_ORIGIN=http://localhost:8080

# MongoDB בתוך Docker — לא לגעת כשמשתמשים ב-compose
# MONGODB_URI=mongodb://mongodb:27017/dykehaton

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
ADMIN_WHITELIST=admin@example.com

# חובה false ב-HTTP מקומי (localhost) כדי שעוגיית האדמין תעבוד
COOKIE_SECURE=false

# --- דוגמאות ---
# פורט אתר אחר:
# WEB_PORT=9090
# CLIENT_ORIGIN=http://localhost:9090
#
# פריסת HTTPS:
# CLIENT_ORIGIN=https://your-domain.com
# COOKIE_SECURE=true
