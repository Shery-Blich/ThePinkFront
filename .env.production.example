# Copy to .env.production and fill in real values before GCP deploy:
#   cp .env.production.example .env.production
#
# Then:
#   npm run deploy:hosting   # Firebase Hosting (Node)
#   or GCP scripts when ready

# --- Google Cloud ---
GCP_PROJECT_ID=thepinkfront
GCP_REGION=me-west1

# Your public origin
CLIENT_ORIGIN=https://your-domain.com

# --- Backend (Cloud Run: thepinkfront-api) ---
# MongoDB Atlas URI for production (never commit the real password)
MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/dykehaton

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
ADMIN_WHITELIST=admin@example.com

# true on HTTPS
COOKIE_SECURE=true
